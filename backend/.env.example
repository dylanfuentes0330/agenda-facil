# Copia este archivo a .env y ajusta los valores. NUNCA subas .env a GitHub.
NODE_ENV=development
PORT=3000

# MySQL local o Amazon RDS (en producción: endpoint de RDS, usuario de aplicación sin privilegios de administrador)
DATABASE_URL="mysql://agenda:CAMBIAR_PASSWORD@localhost:3306/agenda_facil"

# Secreto para firmar JWT (mínimo 32 caracteres aleatorios). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO"
JWT_EXPIRES_IN=8h

# Orígenes permitidos por CORS (separados por coma). En producción el frontend y la API
# comparten dominio a través de CloudFront, pero se deja configurable.
CORS_ORIGINS=http://localhost:5173

# Número de proxies delante de Express (0 local; 2 en AWS: CloudFront + Nginx)
TRUST_PROXY=0

# Intentos permitidos por IP cada 15 minutos en /api/auth/*
RATE_LIMIT_AUTH_MAX=20

# Almacenamiento de logos: local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Solo si STORAGE_DRIVER=s3 (las credenciales salen del rol IAM de la instancia EC2)
S3_BUCKET=
AWS_REGION=us-east-1
