NODE_ENV=test
# La contraseña real va en .env.test.local (ignorado por Git), que tiene prioridad sobre este archivo.
DATABASE_URL="mysql://agenda:CLAVE_LOCAL@127.0.0.1:3306/agenda_facil_test"
JWT_SECRET="test-secret-for-automated-tests-only-0123456789"
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_AUTH_MAX=1000
STORAGE_DRIVER=local
UPLOAD_DIR=tests/.uploads
BCRYPT_ROUNDS=4
