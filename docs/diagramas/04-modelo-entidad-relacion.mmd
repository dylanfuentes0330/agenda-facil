erDiagram
  PLANS ||--o{ BUSINESSES : "define límites de"
  USERS ||--o| BUSINESSES : "administra (owner_id único)"
  USERS ||--o{ CLIENTS : "cuenta en línea de"
  BUSINESSES ||--o{ SERVICES : ofrece
  BUSINESSES ||--|{ BUSINESS_HOURS : "atiende (7 días)"
  BUSINESSES ||--o{ CLIENTS : "tiene (ficha por negocio)"
  BUSINESSES ||--o{ RESERVATIONS : recibe
  SERVICES ||--o{ RESERVATIONS : "se reserva en"
  CLIENTS ||--o{ RESERVATIONS : realiza

  PLANS {
    int id PK
    enum code UK "BASICO | PROFESIONAL"
    varchar name
    int max_services "null = ilimitado"
    int max_clients "null = ilimitado"
    bool advanced_stats
    int trial_days
  }
  USERS {
    int id PK
    varchar email UK
    varchar password_hash "bcrypt"
    varchar name
    varchar phone
    enum role "BUSINESS_ADMIN | CLIENT"
  }
  BUSINESSES {
    int id PK
    int owner_id FK,UK
    int plan_id FK
    varchar name
    varchar slug UK
    varchar category
    varchar timezone
    int slot_interval_minutes
    int cancellation_hours
    varchar logo_key "objeto S3"
    datetime trial_ends_at
  }
  SERVICES {
    int id PK
    int business_id FK
    varchar name "UK con business_id"
    int duration_minutes
    decimal price
    bool is_active
  }
  BUSINESS_HOURS {
    int id PK
    int business_id FK "UK con day_of_week"
    int day_of_week "0-6"
    bool is_open
    char open_time "HH:MM"
    char close_time "HH:MM"
  }
  CLIENTS {
    int id PK
    int business_id FK
    int user_id FK "nullable; UK con business_id"
    varchar name
    varchar email "UK con business_id"
    varchar phone
    varchar notes
  }
  RESERVATIONS {
    int id PK
    int business_id FK
    int service_id FK
    int client_id FK
    datetime start_at "IDX (business_id, start_at)"
    datetime end_at
    enum status "CONFIRMED | COMPLETED | CANCELLED | NO_SHOW"
    decimal price_at_booking
    enum cancelled_by "BUSINESS | CLIENT"
  }
